{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siconnect-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {"bindings": [{"name": "DEVICES", "class_name": "DeviceBridge"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["DeviceBridge"]}],
  "observability": {"enabled": false}
}
